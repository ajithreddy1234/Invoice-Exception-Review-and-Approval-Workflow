# Local HTTP only. On Render set the real HTTPS origin and COOKIE_SECURE=true.
APP_ORIGIN=http://127.0.0.1:8000
COOKIE_SECURE=false
# Copy the actual Supabase Connect > transaction pooler URI; URL-encode password.
# Use ?sslmode=require for the hosted connection and a project-specific database.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Required for private source storage; server only, never expose in browser.
SUPABASE_SECRET_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SPREADSHEET_ID=
GEMINI_API_KEY=
# Set to a currently available free-tier text model in your AI Studio project.
GEMINI_MODEL=
AUTO_IMPORT_ON_STARTUP=true
REFERENCE_TTL_HOURS=24
WORKER_ENABLED=true
STORAGE_BUCKET=invoice-originals

